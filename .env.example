# Neon Postgres connection string (written by `neon link`)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# API key for the ESP32 to POST sensor data
INGEST_API_KEY=your_ingest_api_key_here

# Secret for the cleanup cron endpoint
CRON_SECRET=your_cron_secret_here

# Neon branch metadata (written by `neon link`)
NEON_BRANCH=main
NEON_BRANCH_ID=br-xxxxxxxx
NEON_FUNCTION_HOST_SUFFIX=

